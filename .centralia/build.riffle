# Build configuration for altcontainers, run by Centralia. It replaces the
# GitHub Actions build and manual-build workflows this repository used before
# the move to Centralia.
#
# Java is preinstalled in the build VM under /opt/java/<N>; 17, 21 and 25 are the
# versions CI covered. "requires" lists files that must exist inside the VM
# before the first command runs, and "paths" puts their bin directory in front
# of PATH. The tests start containers, so every job also requires the Docker CLI
# from the VM. Centralia does not install or discover tools.
#
# Validate with:
#   centralia validate .centralia/build.riffle

jobs : {
    build-java-17 : {
        triggers : [
            push
            pull-request
        ]
        labels : [
            linux
        ]
        timeout : 1h
        paths : [
            /opt/java/17/bin
        ]
        environment : {
            JAVA_HOME : /opt/java/17
            MAVEN_OPTS : -Xmx2g -XX:+UseG1GC
        }
        commands : [
            ./mvnw -B -ntp spotless:check
            ./mvnw -B -ntp clean install
        ]
    }
    build-java-21 : {
        triggers : [
            push
            pull-request
        ]
        labels : [
            linux
        ]
        timeout : 1h
        requires : [
            /opt/java/21/bin/java
            /usr/bin/docker
        ]
        paths : [
            /opt/java/21/bin
        ]
        environment : {
            JAVA_HOME : /opt/java/21
            MAVEN_OPTS : -Xmx2g -XX:+UseG1GC
        }
        commands : [
            ./mvnw -B -ntp spotless:check
            ./mvnw -B -ntp clean install
        ]
    }
    build-java-25 : {
        triggers : [
            push
            pull-request
        ]
        labels : [
            linux
        ]
        timeout : 1h
        requires : [
            /opt/java/25/bin/java
            /usr/bin/docker
        ]
        paths : [
            /opt/java/25/bin
        ]
        environment : {
            JAVA_HOME : /opt/java/25
            MAVEN_OPTS : -Xmx2g -XX:+UseG1GC
        }
        commands : [
            ./mvnw -B -ntp spotless:check
            ./mvnw -B -ntp clean install -Dpmd.skip=true
        ]
    }
}
